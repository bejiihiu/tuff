     public static enum SchedulerType {
         EDF,
-        WORK_STEALING;
+        WORK_STEALING,
+        KAIROS
     }
 
     public TickRegionScheduler(final SchedulerType schedulerType, final int initialThreads) {
@@ -66,7 +67,7 @@ public final class TickRegionScheduler {
 
             @Override
             public Thread newThread(final Runnable run) {
-                final Thread ret = new TickThreadRunner(this.threadGroup, run, "Folia Region Scheduler Thread #" + this.idGenerator.getAndIncrement());
+                final Thread ret = new TickThreadRunner(this.threadGroup, kz.bejiihiu.tuff.threads.bridge.RegionThreads.wrapBody(run), "Folia Region Scheduler Thread #" + this.idGenerator.getAndIncrement()); // Tuff - account region tick bodies
                 ret.setUncaughtExceptionHandler(TickRegionScheduler.this::uncaughtException);
                 return ret;
             }
@@ -84,6 +85,17 @@ public final class TickRegionScheduler {
                 ((StealingScheduledThreadPool)this.scheduler).setFlags(StealingScheduledThreadPool.FLAG_SCHEDULE_EVENLY);
                 break;
             }
+            case KAIROS: {
+                this.scheduler = new kz.bejiihiu.tuff.threads.kairos.KairosScheduler(
+                    initialThreads, threadFactory, tick -> ((RegionScheduleHandle)tick).scheduledStart(),
+                    // Tuff - catch up reads the handle's own period count and bounds its write off
+                    new kz.bejiihiu.tuff.threads.kairos.KairosTickControl(
+                        tick -> ((RegionScheduleHandle)tick).missedPeriods(),
+                        (tick, periods) -> ((RegionScheduleHandle)tick).limitWriteOff(periods)
+                    )
+                );
+                break;
+            }
             default: {
                 throw new IllegalStateException("Unknown scheduler type: " + schedulerType);
             }
@@ -93,6 +105,8 @@ public final class TickRegionScheduler {
     public void start() {
         if (this.scheduler instanceof EDFSchedulerThreadPool edfSchedulerThreadPool) {
             edfSchedulerThreadPool.start();
+        } else if (this.scheduler instanceof kz.bejiihiu.tuff.threads.kairos.KairosScheduler kairosScheduler) {
